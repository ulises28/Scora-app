# Scora App — Private Environment Variables Template
# 🔑 Rename this to .env and fill in the values.
# ⚠️ DO NOT COMMIT .env TO GITHUB! (Already in .gitignore)

# Strava API Credentials
VITE_STRAVA_CLIENT_ID=your_client_id_here
VITE_STRAVA_CLIENT_SECRET=your_client_secret_here

# Redis (Upstash) — For Concurrency Queueing
UPSTASH_REDIS_REST_URL=your_upstash_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# --- NEW: Admin Gatekeeper Credentials ---
# Use these for ?admin=scora mode
ADMIN_USER=admin
ADMIN_PASS=scora-super-secret-123
