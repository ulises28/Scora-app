# ============================================================
# Dockerfile.playwright
# Purpose: Run Playwright E2E tests in an isolated Linux container.
# All browsers (Chromium, Firefox, WebKit) are pre-installed in the base image.
#
# Build:  DOCKER_DEFAULT_PLATFORM=linux/amd64 docker build -f Dockerfile.playwright -t scora-e2e .
# Run:    docker compose -f docker-compose.playwright.yml run --rm playwright pnpm exec playwright test --project=UI-Visual
# ============================================================

# Official Scora Runtime — includes Node, pnpm, Vercel CLI, and Playwright browsers
FROM --platform=linux/amd64 ghcr.io/ulises28/scora-runtime:latest

WORKDIR /app

# Install dependencies first for better layer caching
COPY package.json pnpm-lock.yaml ./
# esbuild postinstall must run for the binary; silence pnpm's ignored-builds exit
RUN pnpm install --frozen-lockfile; \
    pnpm rebuild esbuild || true; \
    node -e "require('esbuild')" 2>/dev/null || npm rebuild esbuild

# Project source
COPY . .

# Config shim required by the test pipeline
RUN cp src/config.example.ts src/config.ts

EXPOSE 5500

# CI-like environment inside the container
ENV CI=true

# Default: full E2E (Playwright starts Vite via webServer)
CMD ["pnpm", "exec", "playwright", "test"]
